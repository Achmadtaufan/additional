
# ============================================================
# EXPORT QUERY DARI SQL SERVER KE FILE .SQL
# Filter   : groupmenu = 'SPIN OFF UAT'
# Nama file: menuname.sql
# Isi file : kolom query
# ============================================================

# 1. KONFIGURASI
$server       = "NAMA_SERVER"
$database     = "NAMA_DATABASE"
$tableName    = "dbo.ms_rpt"
$outputFolder = "C:\ExportSQL\Hasil"

# 2. LOGIN SQL SERVER
$username = "zte"
$securePassword = Read-Host "Masukkan password SQL Server" -AsSecureString

$credential = New-Object System.Management.Automation.PSCredential(
    $username,
    $securePassword
)

$passwordPlain = $credential.GetNetworkCredential().Password

# 3. BUAT FOLDER OUTPUT
New-Item -ItemType Directory -Path $outputFolder -Force |
    Out-Null

# 4. CONNECTION STRING
$connectionString = "Server=$server;Database=$database;User ID=$username;Password=$passwordPlain;TrustServerCertificate=True;"

$conn = New-Object System.Data.SqlClient.SqlConnection(
    $connectionString
)

$count = 0
$skipped = 0
$seenNames = @{}

try {
    # 5. BUKA KONEKSI
    $conn.Open()

    Write-Host "Berhasil terhubung ke SQL Server." -ForegroundColor Green

    # 6. AMBIL QUERY SESUAI FILTER
    $cmd = $conn.CreateCommand()
    $cmd.CommandTimeout = 0

    $cmd.CommandText = @"
SELECT
    [menuname],
    [query]
FROM $tableName
WHERE [groupmenu] = @groupmenu
ORDER BY [menuname];
"@

    $param = $cmd.Parameters.Add(
        "@groupmenu",
        [System.Data.SqlDbType]::NVarChar,
        100
    )
    $param.Value = "SPIN OFF UAT"

    $reader = $cmd.ExecuteReader()

    # 7. EXPORT SETIAP ROW MENJADI FILE SQL
    while ($reader.Read()) {

        # Validasi menuname
        if ($reader.IsDBNull($reader.GetOrdinal("menuname"))) {
            Write-Host "Skip: menuname NULL" -ForegroundColor Yellow
            $skipped++
            continue
        }

        # Validasi query
        if ($reader.IsDBNull($reader.GetOrdinal("query"))) {
            Write-Host "Skip: query NULL" -ForegroundColor Yellow
            $skipped++
            continue
        }

        $menuName = [string]$reader["menuname"]
        $sqlText  = [string]$reader["query"]

        # Bersihkan karakter nama file yang tidak valid
        $safeName = $menuName -replace '[\\/:*?"<>|]', '_'
        $safeName = $safeName.Trim().TrimEnd('.')

        if ([string]::IsNullOrWhiteSpace($safeName)) {
            Write-Host "Skip: nama file kosong" -ForegroundColor Yellow
            $skipped++
            continue
        }

        # Hindari nama file duplikat atau bentrok
        $key = $safeName.ToLowerInvariant()

        if ($seenNames.ContainsKey($key)) {
            Write-Host "Skip: nama file duplikat: $safeName.sql" -ForegroundColor Yellow
            $skipped++
            continue
        }

        $seenNames[$key] = $true

        # Bentuk nama file berdasarkan menuname
        $filePath = Join-Path $outputFolder "$safeName.sql"

        # Simpan query tanpa header tambahan
        [System.IO.File]::WriteAllText(
            $filePath,
            $sqlText,
            [System.Text.UTF8Encoding]::new($false)
        )

        $count++

        Write-Host "Export: $safeName.sql" -ForegroundColor Green

        Write-Progress `
            -Activity "Export query SQL" `
            -Status "Berhasil export: $count file"
    }

    $reader.Close()

    # 8. RINGKASAN
    Write-Host ""
    Write-Host "========================================"
    Write-Host "EXPORT SELESAI"
    Write-Host "Total file berhasil : $count"
    Write-Host "Row dilewati        : $skipped"
    Write-Host "Folder output       : $outputFolder"
    Write-Host "Filter              : SPIN OFF UAT"
    Write-Host "========================================" -ForegroundColor Green
}
catch {
    Write-Host "EXPORT GAGAL!" -ForegroundColor Red
    Write-Host $_.Exception.Message -ForegroundColor Red
}
finally {
    if ($null -ne $conn) {
        $conn.Dispose()
    }

    $passwordPlain = $null
}
