;WITH CTE AS
(
    SELECT
        menuName,
        CAST([query] AS VARCHAR(MAX)) AS queryText
    FROM comp
),
Keywords AS
(
    SELECT ' FROM ' AS Keyword
    UNION ALL SELECT ' LEFT JOIN '
    UNION ALL SELECT ' RIGHT JOIN '
    UNION ALL SELECT ' INNER JOIN '
    UNION ALL SELECT ' FULL JOIN '
    UNION ALL SELECT ' LEFT OUTER JOIN '
    UNION ALL SELECT ' RIGHT OUTER JOIN '
    UNION ALL SELECT ' FULL OUTER JOIN '
    UNION ALL SELECT ' CROSS JOIN '
    UNION ALL SELECT ' JOIN '
),
FindObject AS
(
    SELECT
        c.menuName,
        c.queryText,
        k.Keyword,
        CHARINDEX(
            k.Keyword,
            ' ' + UPPER(c.queryText) + ' '
        ) AS KeywordPosition
    FROM CTE c
    CROSS JOIN Keywords k
),
ObjectPosition AS
(
    SELECT
        menuName,
        queryText,
        Keyword,
        KeywordPosition,
        LEN(Keyword) AS KeywordLength
    FROM FindObject
    WHERE KeywordPosition > 0
),
ExtractObject AS
(
    SELECT
        menuName,

        objectRaw =
            LTRIM(RTRIM(
                LEFT(
                    SUBSTRING(
                        queryText,
                        KeywordPosition + KeywordLength,
                        LEN(queryText)
                    ),
                    CHARINDEX(
                        ' ',
                        SUBSTRING(
                            queryText,
                            KeywordPosition + KeywordLength,
                            LEN(queryText)
                        ) + ' '
                    ) - 1
                )
            ))
    FROM ObjectPosition
),
FinalData AS
(
    SELECT
        menuName,

        objectName =
            CASE
                WHEN objectRaw LIKE '%].[%'
                    THEN PARSENAME(
                        REPLACE(
                            REPLACE(objectRaw, '[', ''),
                            ']', ''
                        ),
                        1
                    )

                WHEN objectRaw LIKE '%.%'
                    THEN PARSENAME(
                        REPLACE(
                            REPLACE(objectRaw, '[', ''),
                            ']', ''
                        ),
                        1
                    )

                ELSE
                    REPLACE(
                        REPLACE(objectRaw, '[', ''),
                        ']', ''
                    )
            END

    FROM ExtractObject
)
SELECT DISTINCT
    menuName,
    objectName
FROM FinalData
WHERE NULLIF(LTRIM(RTRIM(objectName)), '') IS NOT NULL
  AND UPPER(LTRIM(RTRIM(objectName))) <> '( SELECT'
  AND UPPER(REPLACE(LTRIM(RTRIM(objectName)), ' ', '')) <> '(SELECT'
ORDER BY
    menuName,
    objectName;