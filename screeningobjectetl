# ============================================================
# CONFIG
# ============================================================

$DtsxFolder = "C:\screening"
$ObjectFile = "C:\tes\screening.txt"
$OutputCsv  = "C:\tes\hasil_screening_dtsx.csv"

# ============================================================
# VALIDASI FILE / FOLDER
# ============================================================

if (-not (Test-Path $DtsxFolder)) {
    Write-Host "Folder DTSX tidak ditemukan: $DtsxFolder" -ForegroundColor Red
    exit
}

if (-not (Test-Path $ObjectFile)) {
    Write-Host "File object tidak ditemukan: $ObjectFile" -ForegroundColor Red
    exit
}

# ============================================================
# BACA OBJECT LIST
# ============================================================

$Objects = @(
    Get-Content -Path $ObjectFile |
    ForEach-Object {
        $_.Trim()
    } |
    Where-Object {
        $_ -ne ""
    } |
    Sort-Object -Unique
)

if ($Objects.Count -eq 0) {
    Write-Host "Tidak ada object di $ObjectFile" -ForegroundColor Red
    exit
}

# ============================================================
# AMBIL SEMUA DTSX
# ============================================================

$DtsxFiles = @(
    Get-ChildItem `
        -Path $DtsxFolder `
        -Filter "*.dtsx" `
        -File `
        -Recurse `
        -ErrorAction SilentlyContinue
)

if ($DtsxFiles.Count -eq 0) {
    Write-Host "Tidak ada file DTSX ditemukan." -ForegroundColor Red
    exit
}

Write-Host ""
Write-Host "============================================" -ForegroundColor Cyan
Write-Host "SCREENING DTSX" -ForegroundColor Cyan
Write-Host "============================================" -ForegroundColor Cyan
Write-Host "Object list : $($Objects.Count)"
Write-Host "DTSX files  : $($DtsxFiles.Count)"
Write-Host "Output      : $OutputCsv"
Write-Host "============================================" -ForegroundColor Cyan
Write-Host ""

# ============================================================
# FUNCTION: GET ATTRIBUTE BERDASARKAN LOCALNAME
# ============================================================

function Get-XmlAttribute {
    param (
        [System.Xml.XmlNode]$Node,
        [string]$Name
    )

    if ($null -eq $Node) {
        return $null
    }

    foreach ($Attribute in $Node.Attributes) {
        if ($Attribute.LocalName -eq $Name) {
            return $Attribute.Value
        }
    }

    return $null
}

# ============================================================
# FUNCTION: GET COMPONENT PROPERTY
# ============================================================

function Get-PropertyValue {
    param (
        [System.Xml.XmlNode]$Component,
        [string[]]$Names
    )

    $Properties = $Component.SelectNodes(
        ".//*[local-name()='property']"
    )

    foreach ($Property in $Properties) {

        $PropertyName = Get-XmlAttribute `
            -Node $Property `
            -Name "name"

        if ($null -ne $PropertyName) {

            foreach ($Name in $Names) {

                if ($PropertyName -ieq $Name) {

                    $Value = $Property.InnerText

                    if ($null -ne $Value) {
                        return $Value.Trim()
                    }
                }
            }
        }
    }

    return $null
}

# ============================================================
# FUNCTION: GET CONNECTION MANAGER ID
# ============================================================

function Get-ConnectionManagerID {
    param (
        [System.Xml.XmlNode]$Component
    )

    $Connections = $Component.SelectNodes(
        ".//*[local-name()='connection']"
    )

    foreach ($Connection in $Connections) {

        $ID = Get-XmlAttribute `
            -Node $Connection `
            -Name "connectionManagerID"

        if ($ID) {
            return $ID
        }
    }

    return $null
}

# ============================================================
# FUNCTION: PARSE CONNECTION STRING
# ============================================================

function Get-ConnectionInfo {
    param (
        [System.Xml.XmlNode]$ConnectionManager
    )

    $XmlText = $ConnectionManager.OuterXml

    $Server = $null
    $Database = $null

    # -----------------------------
    # SERVER
    # -----------------------------

    $MatchServer = [regex]::Match(
        $XmlText,
        '(?i)(?:Data Source|Server)\s*=\s*([^;"]+)'
    )

    if ($MatchServer.Success) {
        $Server = $MatchServer.Groups[1].Value.Trim()
    }

    # -----------------------------
    # DATABASE
    # -----------------------------

    $MatchDatabase = [regex]::Match(
        $XmlText,
        '(?i)(?:Initial Catalog|Database)\s*=\s*([^;"]+)'
    )

    if ($MatchDatabase.Success) {
        $Database = $MatchDatabase.Groups[1].Value.Trim()
    }

    return @{
        Server   = $Server
        Database = $Database
    }
}

# ============================================================
# FUNCTION: GET EXECUTABLE / CONTAINER NAME
# ============================================================

function Get-ContainerName {
    param (
        [System.Xml.XmlNode]$Pipeline
    )

    # Cari executable parent terdekat
    $ParentExecutable = $Pipeline.SelectSingleNode(
        "ancestor::*[local-name()='executable'][1]"
    )

    if ($null -eq $ParentExecutable) {
        return "(Data Flow Task)"
    }

    # Cari ObjectName attribute
    $ObjectName = Get-XmlAttribute `
        -Node $ParentExecutable `
        -Name "ObjectName"

    if ($ObjectName) {
        return $ObjectName
    }

    # Fallback: cari property ObjectName
    $Properties = $ParentExecutable.SelectNodes(
        ".//*[local-name()='property']"
    )

    foreach ($Property in $Properties) {

        $PropertyName = Get-XmlAttribute `
            -Node $Property `
            -Name "name"

        if ($PropertyName -ieq "ObjectName") {

            if ($Property.InnerText) {
                return $Property.InnerText.Trim()
            }
        }
    }

    return "(Data Flow Task)"
}

# ============================================================
# RESULT
# ============================================================

$Results = New-Object System.Collections.Generic.List[object]

# ============================================================
# LOOP DTSX
# ============================================================

$FileCounter = 0
$TotalFiles = $DtsxFiles.Count

foreach ($DtsxFile in $DtsxFiles) {

    $FileCounter++

    $Percent = [math]::Round(
        ($FileCounter / $TotalFiles) * 100,
        0
    )

    Write-Progress `
        -Activity "Scanning DTSX" `
        -Status "$FileCounter / $TotalFiles - $($DtsxFile.Name)" `
        -PercentComplete $Percent

    Write-Host (
        "[{0}/{1}] {2}" -f
        $FileCounter,
        $TotalFiles,
        $DtsxFile.Name
    ) -ForegroundColor DarkGray

    try {

        # ====================================================
        # LOAD XML
        # ====================================================

        $XmlContent = Get-Content `
            -Path $DtsxFile.FullName `
            -Raw `
            -ErrorAction Stop

        [xml]$Xml = $XmlContent

        # ====================================================
        # CONNECTION MANAGERS
        # ====================================================

        $ConnectionManagers = @{}

        $CMNodes = $Xml.SelectNodes(
            "//*[local-name()='connectionManager']"
        )

        foreach ($CM in $CMNodes) {

            $CMID = Get-XmlAttribute `
                -Node $CM `
                -Name "DTSID"

            if (-not $CMID) {
                continue
            }

            $ConnectionInfo = Get-ConnectionInfo `
                -ConnectionManager $CM

            $ConnectionManagers[$CMID] = @{
                Server   = $ConnectionInfo.Server
                Database = $ConnectionInfo.Database
            }
        }

        # ====================================================
        # CARI SEMUA PIPELINE
        # ====================================================

        $Pipelines = $Xml.SelectNodes(
            "//*[local-name()='pipeline']"
        )

        foreach ($Pipeline in $Pipelines) {

            # =================================================
            # CONTAINER / DATA FLOW TASK
            # =================================================

            $ContainerName = Get-ContainerName `
                -Pipeline $Pipeline

            # =================================================
            # SEMUA COMPONENT DALAM PIPELINE
            # =================================================

            $Components = @(
                $Pipeline.SelectNodes(
                    ".//*[local-name()='component']"
                )
            )

            if ($Components.Count -eq 0) {
                continue
            }

            # =================================================
            # CARI OLE DB SOURCE
            # =================================================

            foreach ($SourceComponent in $Components) {

                $SourceName = Get-XmlAttribute `
                    -Node $SourceComponent `
                    -Name "name"

                $SourceClass = Get-XmlAttribute `
                    -Node $SourceComponent `
                    -Name "componentClassID"

                # ------------------------------------------------
                # CEK APAKAH OLE DB SOURCE
                # ------------------------------------------------

                $IsSource = $false

                if ($SourceClass -match "(?i)OLEDBSource") {
                    $IsSource = $true
                }

                if ($SourceName -match "(?i)OLE DB Source") {
                    $IsSource = $true
                }

                if ($SourceName -match "(?i)OLEDB Source") {
                    $IsSource = $true
                }

                if (-not $IsSource) {
                    continue
                }

                # =================================================
                # CEK SETIAP OBJECT
                # =================================================

                foreach ($ObjectName in $Objects) {

                    $Pattern = "(?i)(?<![A-Za-z0-9_])" +
                               [regex]::Escape($ObjectName) +
                               "(?![A-Za-z0-9_])"

                    $SourceXml = $SourceComponent.OuterXml

                    if ($SourceXml -notmatch $Pattern) {
                        continue
                    }

                    Write-Host (
                        "    FOUND : {0} | Container: {1}" -f
                        $ObjectName,
                        $ContainerName
                    ) -ForegroundColor Green

                    # =================================================
                    # SOURCE CONNECTION
                    # =================================================

                    $SourceCMID = Get-ConnectionManagerID `
                        -Component $SourceComponent

                    $SourceServer = $null
                    $SourceDatabase = $null

                    if (
                        $SourceCMID -and
                        $ConnectionManagers.ContainsKey($SourceCMID)
                    ) {

                        $SourceServer =
                            $ConnectionManagers[$SourceCMID].Server

                        $SourceDatabase =
                            $ConnectionManagers[$SourceCMID].Database
                    }

                    # =================================================
                    # CARI SEMUA OLE DB DESTINATION
                    # DALAM PIPELINE YANG SAMA
                    # =================================================

                    $DestinationFound = $false

                    foreach ($DestinationComponent in $Components) {

                        $DestinationName = Get-XmlAttribute `
                            -Node $DestinationComponent `
                            -Name "name"

                        $DestinationClass = Get-XmlAttribute `
                            -Node $DestinationComponent `
                            -Name "componentClassID"

                        $IsDestination = $false

                        if (
                            $DestinationClass -match "(?i)OLEDBDestination"
                        ) {
                            $IsDestination = $true
                        }

                        if (
                            $DestinationName -match "(?i)OLE DB Destination"
                        ) {
                            $IsDestination = $true
                        }

                        if (
                            $DestinationName -match "(?i)OLEDB Destination"
                        ) {
                            $IsDestination = $true
                        }

                        if (-not $IsDestination) {
                            continue
                        }

                        $DestinationFound = $true

                        # =================================================
                        # DESTINATION CONNECTION
                        # =================================================

                        $DestinationCMID =
                            Get-ConnectionManagerID `
                                -Component $DestinationComponent

                        $DestinationServer = $null
                        $DestinationDatabase = $null

                        if (
                            $DestinationCMID -and
                            $ConnectionManagers.ContainsKey(
                                $DestinationCMID
                            )
                        ) {

                            $DestinationServer =
                                $ConnectionManagers[
                                    $DestinationCMID
                                ].Server

                            $DestinationDatabase =
                                $ConnectionManagers[
                                    $DestinationCMID
                                ].Database
                        }

                        # =================================================
                        # DESTINATION TABLE
                        # =================================================

                        $DestinationTable =
                            Get-PropertyValue `
                                -Component $DestinationComponent `
                                -Names @(
                                    "OpenRowset",
                                    "TableName",
                                    "DestinationTable"
                                )

                        # =================================================
                        # ADD RESULT
                        # =================================================

                        $Results.Add(
                            [PSCustomObject]@{
                                ObjectName          = $ObjectName
                                DTSXFile            = $DtsxFile.Name
                                ContainerName       = $ContainerName
                                SourceServer        = $SourceServer
                                SourceDatabase      = $SourceDatabase
                                DestinationServer   = $DestinationServer
                                DestinationDatabase = $DestinationDatabase
                                DestinationTable    = $DestinationTable
                            }
                        )
                    }

                    # =================================================
                    # SOURCE ADA, DESTINATION TIDAK ADA
                    # =================================================

                    if (-not $DestinationFound) {

                        $Results.Add(
                            [PSCustomObject]@{
                                ObjectName          = $ObjectName
                                DTSXFile            = $DtsxFile.Name
                                ContainerName       = $ContainerName
                                SourceServer        = $SourceServer
                                SourceDatabase      = $SourceDatabase
                                DestinationServer   = $null
                                DestinationDatabase = $null
                                DestinationTable    = $null
                            }
                        )
                    }
                }
            }
        }
    }
    catch {

        Write-Host ""
        Write-Host "ERROR pada file:" -ForegroundColor Red
        Write-Host $DtsxFile.FullName -ForegroundColor Red
        Write-Host $_.Exception.Message -ForegroundColor Red
        Write-Host ""
    }
}

Write-Progress `
    -Activity "Scanning DTSX" `
    -Completed

# ============================================================
# REMOVE DUPLICATE
# ============================================================

$FinalResults = @(
    $Results |
    Sort-Object `
        ObjectName,
        DTSXFile,
        ContainerName,
        SourceServer,
        SourceDatabase,
        DestinationServer,
        DestinationDatabase,
        DestinationTable `
    -Unique
)

# ============================================================
# EXPORT CSV
# ============================================================

$FinalResults |
    Export-Csv `
        -Path $OutputCsv `
        -NoTypeInformation `
        -Encoding UTF8

# ============================================================
# SUMMARY
# ============================================================

Write-Host ""
Write-Host "============================================" -ForegroundColor Cyan
Write-Host "SELESAI" -ForegroundColor Green
Write-Host "============================================" -ForegroundColor Cyan
Write-Host "Object ditemukan : $($FinalResults.Count)"
Write-Host "DTSX diperiksa   : $TotalFiles"
Write-Host "Output CSV       : $OutputCsv"
Write-Host "============================================" -ForegroundColor Cyan