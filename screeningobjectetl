# ============================================================
# CONFIG
# ============================================================

$DtsxFolder = "C:\screening"
$ObjectFile = "C:\tes\screening.txt"
$OutputCsv  = "C:\tes\hasil_screening_dtsx.csv"

# ============================================================
# READ OBJECT LIST
# ============================================================

$Objects = Get-Content $ObjectFile |
    ForEach-Object { $_.Trim() } |
    Where-Object { $_ -ne "" } |
    Sort-Object -Unique

if ($Objects.Count -eq 0) {
    Write-Host "Tidak ada object di $ObjectFile" -ForegroundColor Red
    exit
}

Write-Host "Jumlah object : $($Objects.Count)" -ForegroundColor Cyan

# ============================================================
# GET DTSX FILES
# ============================================================

$DtsxFiles = Get-ChildItem `
    -Path $DtsxFolder `
    -Filter "*.dtsx" `
    -File `
    -Recurse

Write-Host "Jumlah DTSX   : $($DtsxFiles.Count)" -ForegroundColor Cyan
Write-Host ""

# ============================================================
# HELPER : GET XML ATTRIBUTE BY LOCAL NAME
# ============================================================

function Get-XmlAttributeValue {
    param (
        [System.Xml.XmlNode]$Node,
        [string]$AttributeName
    )

    if ($null -eq $Node) {
        return $null
    }

    foreach ($Attr in $Node.Attributes) {
        if ($Attr.LocalName -eq $AttributeName) {
            return $Attr.Value
        }
    }

    return $null
}

# ============================================================
# HELPER : GET COMPONENT PROPERTY
# ============================================================

function Get-ComponentProperty {
    param (
        [System.Xml.XmlNode]$Component,
        [string[]]$PropertyNames
    )

    $Properties = $Component.SelectNodes(
        ".//*[local-name()='property']"
    )

    foreach ($Property in $Properties) {

        $Name = Get-XmlAttributeValue `
            -Node $Property `
            -AttributeName "name"

        if ($Name -and ($PropertyNames -contains $Name)) {
            return $Property.InnerText.Trim()
        }
    }

    return $null
}

# ============================================================
# HELPER : GET CONNECTION MANAGER ID FROM COMPONENT
# ============================================================

function Get-ComponentConnectionManagerID {
    param (
        [System.Xml.XmlNode]$Component
    )

    $Connections = $Component.SelectNodes(
        ".//*[local-name()='connection']"
    )

    foreach ($Connection in $Connections) {

        $ID = Get-XmlAttributeValue `
            -Node $Connection `
            -AttributeName "connectionManagerID"

        if ($ID) {
            return $ID
        }
    }

    return $null
}

# ============================================================
# HELPER : GET CONNECTION MANAGER INFORMATION
# ============================================================

function Get-ConnectionInfo {
    param (
        [System.Xml.XmlNode]$ConnectionManager
    )

    $OuterXml = $ConnectionManager.OuterXml

    $Server   = $null
    $Database = $null

    # Data Source / Server
    $ServerMatch = [regex]::Match(
        $OuterXml,
        "(?i)(?:Data Source|Server)\s*=\s*([^;]+)"
    )

    if ($ServerMatch.Success) {
        $Server = $ServerMatch.Groups[1].Value.Trim()
    }

    # Initial Catalog / Database
    $DatabaseMatch = [regex]::Match(
        $OuterXml,
        "(?i)(?:Initial Catalog|Database)\s*=\s*([^;]+)"
    )

    if ($DatabaseMatch.Success) {
        $Database = $DatabaseMatch.Groups[1].Value.Trim()
    }

    return @{
        Server   = $Server
        Database = $Database
    }
}

# ============================================================
# HELPER : GET CONNECTION MANAGER NAME
# ============================================================

function Get-ConnectionManagerName {
    param (
        [System.Xml.XmlNode]$ConnectionManager
    )

    $Name = Get-XmlAttributeValue `
        -Node $ConnectionManager `
        -AttributeName "ObjectName"

    if ($Name) {
        return $Name
    }

    return $null
}

# ============================================================
# RESULT ARRAY
# ============================================================

$Results = New-Object System.Collections.Generic.List[object]

$TotalFiles = $DtsxFiles.Count
$FileNumber = 0

# ============================================================
# SCAN DTSX
# ============================================================

foreach ($DtsxFile in $DtsxFiles) {

    $FileNumber++

    $Percent = [math]::Round(
        ($FileNumber / $TotalFiles) * 100,
        0
    )

    Write-Progress `
        -Activity "Scanning DTSX" `
        -Status "$FileNumber / $TotalFiles : $($DtsxFile.Name)" `
        -PercentComplete $Percent

    Write-Host `
        "[$FileNumber/$TotalFiles] $($DtsxFile.FullName)" `
        -ForegroundColor DarkGray

    try {

        # ----------------------------------------------------
        # LOAD XML
        # ----------------------------------------------------

        [xml]$Xml = Get-Content `
            -Path $DtsxFile.FullName `
            -Raw `
            -ErrorAction Stop

        # ----------------------------------------------------
        # GET ALL CONNECTION MANAGERS
        # ----------------------------------------------------

        $ConnectionManagers = @{}

        $CMNodes = $Xml.SelectNodes(
            "//*[local-name()='connectionManager']"
        )

        foreach ($CM in $CMNodes) {

            $CMID = Get-XmlAttributeValue `
                -Node $CM `
                -AttributeName "DTSID"

            if ($CMID) {

                $Info = Get-ConnectionInfo `
                    -ConnectionManager $CM

                $ConnectionManagers[$CMID] = @{
                    Name     = Get-ConnectionManagerName $CM
                    Server   = $Info.Server
                    Database = $Info.Database
                }
            }
        }

        # ----------------------------------------------------
        # FIND ALL PIPELINES / DATA FLOW TASKS
        # ----------------------------------------------------

        $Pipelines = $Xml.SelectNodes(
            "//*[local-name()='pipeline']"
        )

        foreach ($Pipeline in $Pipelines) {

            # ------------------------------------------------
            # FIND PARENT EXECUTABLE / DATA FLOW TASK
            # ------------------------------------------------

            $ContainerName = $null

            $ParentExecutable = $Pipeline.SelectSingleNode(
                "ancestor::*[local-name()='executable'][1]"
            )

            if ($ParentExecutable) {

                $ContainerName = Get-XmlAttributeValue `
                    -Node $ParentExecutable `
                    -AttributeName "ObjectName"

                # Jika tidak ketemu, coba cari descendant ObjectName
                if (-not $ContainerName) {

                    $ObjectNameNode = $ParentExecutable.SelectSingleNode(
                        ".//*[local-name()='property' and translate(@name,'ABCDEFGHIJKLMNOPQRSTUVWXYZ','abcdefghijklmnopqrstuvwxyz')='objectname'][1]"
                    )

                    if ($ObjectNameNode) {
                        $ContainerName = $ObjectNameNode.InnerText.Trim()
                    }
                }
            }

            if (-not $ContainerName) {
                $ContainerName = "(Data Flow Task)"
            }

            # ------------------------------------------------
            # GET ALL COMPONENTS IN THIS DATA FLOW
            # ------------------------------------------------

            $Components = @(
                $Pipeline.SelectNodes(
                    ".//*[local-name()='component']"
                )
            )

            if ($Components.Count -eq 0) {
                continue
            }

            # ------------------------------------------------
            # FIND OLE DB SOURCE COMPONENTS
            # ------------------------------------------------

            $SourceComponents = @()

            foreach ($Component in $Components) {

                $ComponentClass = Get-XmlAttributeValue `
                    -Node $Component `
                    -AttributeName "componentClassID"

                $ComponentName = Get-XmlAttributeValue `
                    -Node $Component `
                    -AttributeName "name"

                $ComponentXml = $Component.OuterXml

                $IsOleDbSource = $false

                if (
                    $ComponentClass -match "(?i)OLEDBSource"
                    -or
                    $ComponentName -match "(?i)OLE DB Source|OLEDB Source"
                ) {
                    $IsOleDbSource = $true
                }

                if ($IsOleDbSource) {

                    foreach ($ObjectName in $Objects) {

                        # Exact-ish object name matching
                        $Pattern = "(?i)(?<![A-Za-z0-9_])" +
                                   [regex]::Escape($ObjectName) +
                                   "(?![A-Za-z0-9_])"

                        if ($ComponentXml -match $Pattern) {

                            $SourceComponents += @{
                                ObjectName      = $ObjectName
                                Component        = $Component
                                ComponentName    = $ComponentName
                                ComponentClass  = $ComponentClass
                            }
                        }
                    }
                }
            }

            # ------------------------------------------------
            # IF NO SOURCE FOUND, CONTINUE
            # ------------------------------------------------

            if ($SourceComponents.Count -eq 0) {
                continue
            }

            # ------------------------------------------------
            # FIND OLE DB DESTINATIONS
            # ------------------------------------------------

            $DestinationComponents = @()

            foreach ($Component in $Components) {

                $ComponentClass = Get-XmlAttributeValue `
                    -Node $Component `
                    -AttributeName "componentClassID"

                $ComponentName = Get-XmlAttributeValue `
                    -Node $Component `
                    -AttributeName "name"

                $IsOleDbDestination = $false

                if (
                    $ComponentClass -match "(?i)OLEDBDestination"
                    -or
                    $ComponentName -match "(?i)OLE DB Destination|OLEDB Destination"
                ) {
                    $IsOleDbDestination = $true
                }

                if ($IsOleDbDestination) {

                    $DestinationComponents += @{
                        Component       = $Component
                        ComponentName   = $ComponentName
                        ComponentClass  = $ComponentClass
                    }
                }
            }

            # ------------------------------------------------
            # PROCESS EACH MATCHING SOURCE
            # ------------------------------------------------

            foreach ($Source in $SourceComponents) {

                $SourceComponent = $Source.Component

                $SourceConnectionID =
                    Get-ComponentConnectionManagerID `
                        -Component $SourceComponent

                $SourceServer   = $null
                $SourceDatabase = $null

                if (
                    $SourceConnectionID `
                    -and `
                    $ConnectionManagers.ContainsKey($SourceConnectionID)
                ) {

                    $SourceServer =
                        $ConnectionManagers[$SourceConnectionID].Server

                    $SourceDatabase =
                        $ConnectionManagers[$SourceConnectionID].Database
                }

                # ------------------------------------------------
                # DESTINATION
                # ------------------------------------------------

                if ($DestinationComponents.Count -eq 0) {

                    $Results.Add([PSCustomObject]@{

                        ObjectName           = $Source.ObjectName
                        DTSXFile             = $DtsxFile.Name
                        ContainerName        = $ContainerName
                        SourceServer         = $SourceServer
                        SourceDatabase       = $SourceDatabase
                        DestinationServer    = $null
                        DestinationDatabase  = $null
                        DestinationTable     = $null

                    })

                    continue
                }

                # ------------------------------------------------
                # ONE ROW PER DESTINATION
                # ------------------------------------------------

                foreach ($Destination in $DestinationComponents) {

                    $DestinationComponent =
                        $Destination.Component

                    $DestinationConnectionID =
                        Get-ComponentConnectionManagerID `
                            -Component $DestinationComponent

                    $DestinationServer   = $null
                    $DestinationDatabase = $null

                    if (
                        $DestinationConnectionID `
                        -and `
                        $ConnectionManagers.ContainsKey(
                            $DestinationConnectionID
                        )
                    ) {

                        $DestinationServer =
                            $ConnectionManagers[
                                $DestinationConnectionID
                            ].Server

                        $DestinationDatabase =
                            $ConnectionManagers[
                                $DestinationConnectionID
                            ].Database
                    }

                    # ------------------------------------------------
                    # DESTINATION TABLE
                    # ------------------------------------------------

                    $DestinationTable =
                        Get-ComponentProperty `
                            -Component $DestinationComponent `
                            -PropertyNames @(
                                "OpenRowset",
                                "TableName",
                                "DestinationTable"
                            )

                    # ------------------------------------------------
                    # ADD RESULT
                    # ------------------------------------------------

                    $Results.Add([PSCustomObject]@{

                        ObjectName           = $Source.ObjectName
                        DTSXFile             = $DtsxFile.Name
                        ContainerName        = $ContainerName
                        SourceServer         = $SourceServer
                        SourceDatabase       = $SourceDatabase
                        DestinationServer    = $DestinationServer
                        DestinationDatabase  = $DestinationDatabase
                        DestinationTable     = $DestinationTable

                    })
                }
            }
        }

    }
    catch {

        Write-Host `
            "ERROR: $($DtsxFile.FullName)" `
            -ForegroundColor Red

        Write-Host `
            $_.Exception.Message `
            -ForegroundColor Red
    }
}

Write-Progress `
    -Activity "Scanning DTSX" `
    -Completed

# ============================================================
# REMOVE DUPLICATES
# ============================================================

$Results =
    $Results |
    Sort-Object `
        ObjectName,
        DTSXFile,
        ContainerName,
        SourceServer,
        SourceDatabase,
        DestinationServer,
        DestinationDatabase,
        DestinationTable `
    -Unique

# ============================================================
# EXPORT CSV
# ============================================================

$Results |
    Export-Csv `
        -Path $OutputCsv `
        -NoTypeInformation `
        -Encoding UTF8

# ============================================================
# SUMMARY
# ============================================================

Write-Host ""
Write-Host "============================================" -ForegroundColor Cyan
Write-Host "SELESAI" -ForegroundColor Green
Write-Host "============================================" -ForegroundColor Cyan
Write-Host "Object        : $($Objects.Count)"
Write-Host "DTSX          : $($DtsxFiles.Count)"
Write-Host "Hasil         : $($Results.Count) baris"
Write-Host "Output CSV    : $OutputCsv"
Write-Host "============================================" -ForegroundColor Cyan