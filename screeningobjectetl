$DtsxFolder = "C:\screening"
$ObjectFile = "C:\tes\screening.txt"
$OutputFile = "C:\tes\hasil_screening_dtsx.csv"

Write-Host ""
Write-Host "============================================================" -ForegroundColor Cyan
Write-Host "              DTSX OBJECT SCREENING" -ForegroundColor Cyan
Write-Host "============================================================" -ForegroundColor Cyan
Write-Host "DTSX Folder : $DtsxFolder"
Write-Host "Object List : $ObjectFile"
Write-Host "Output      : $OutputFile"
Write-Host "============================================================"
Write-Host ""

# ============================================================
# BACA OBJECT DARI TXT
# ============================================================

$Objects = @(
    Get-Content -LiteralPath $ObjectFile |
    ForEach-Object { $_.Trim() } |
    Where-Object { $_ -ne "" } |
    Select-Object -Unique
)

$TotalObjects = $Objects.Count

Write-Host "Total object yang akan dicari : $TotalObjects" -ForegroundColor Yellow
Write-Host ""

# ============================================================
# BACA SEMUA DTSX
# ============================================================

$Files = @(
    Get-ChildItem `
        -Path $DtsxFolder `
        -Filter "*.dtsx" `
        -File `
        -Recurse
)

$TotalFiles = $Files.Count

Write-Host "Total file DTSX              : $TotalFiles" -ForegroundColor Yellow
Write-Host ""

$Results = New-Object System.Collections.Generic.List[object]

$ObjectCounter = 0

# ============================================================
# LOOP OBJECT
# ============================================================

foreach ($ObjectName in $Objects) {

    $ObjectCounter++

    $ObjectPercent = [math]::Round(
        ($ObjectCounter / $TotalObjects) * 100,
        0
    )

    Write-Host ""
    Write-Host "============================================================" -ForegroundColor DarkCyan
    Write-Host "OBJECT [$ObjectCounter/$TotalObjects - $ObjectPercent%] : $ObjectName" -ForegroundColor Cyan
    Write-Host "============================================================" -ForegroundColor DarkCyan

    $FileCounter = 0
    $ObjectFound = $false

    # ========================================================
    # LOOP DTSX
    # ========================================================

    foreach ($File in $Files) {

        $FileCounter++

        $FilePercent = [math]::Round(
            ($FileCounter / $TotalFiles) * 100,
            0
        )

        Write-Progress `
            -Id 1 `
            -Activity "Scanning Object: $ObjectName" `
            -Status "$FileCounter / $TotalFiles - $FilePercent% - $($File.Name)" `
            -PercentComplete $FilePercent

        try {

            # ------------------------------------------------
            # BACA DTSX
            # ------------------------------------------------

            $Content = Get-Content `
                -LiteralPath $File.FullName `
                -Raw `
                -ErrorAction Stop

            # ------------------------------------------------
            # CEK OBJECT
            # ------------------------------------------------

            if (
                $Content -notmatch "(?i)(?<![A-Za-z0-9_])$([regex]::Escape($ObjectName))(?![A-Za-z0-9_])"
            ) {
                continue
            }

            Write-Host ""
            Write-Host "  MATCH -> $($File.Name)" -ForegroundColor Green

            [xml]$Xml = $Content

            # =================================================
            # CONNECTION MANAGERS
            # =================================================

            $Connections = @{}

            $ConnectionNodes = $Xml.SelectNodes(
                "//*[local-name()='connectionManager']"
            )

            foreach ($CM in $ConnectionNodes) {

                $CMId = ""

                if ($CM.Attributes["DTSID"]) {
                    $CMId = $CM.Attributes["DTSID"].Value
                }

                if ($CMId -eq "") {
                    continue
                }

                $CMName = ""

                if ($CM.Attributes["DTS:ObjectName"]) {
                    $CMName = $CM.Attributes["DTS:ObjectName"].Value
                }

                if (
                    $CMName -eq "" -and
                    $CM.Attributes["ObjectName"]
                ) {
                    $CMName = $CM.Attributes["ObjectName"].Value
                }

                $CMXML = $CM.OuterXml

                # --------------------------------------------
                # SERVER
                # --------------------------------------------

                $Server = ""

                $Match = [regex]::Match(
                    $CMXML,
                    '(?i)(?:Data Source|Server)\s*=\s*([^;"]+)'
                )

                if ($Match.Success) {
                    $Server = $Match.Groups[1].Value.Trim()
                }

                # --------------------------------------------
                # DATABASE
                # --------------------------------------------

                $Database = ""

                $Match = [regex]::Match(
                    $CMXML,
                    '(?i)(?:Initial Catalog|Database)\s*=\s*([^;"]+)'
                )

                if ($Match.Success) {
                    $Database = $Match.Groups[1].Value.Trim()
                }

                $Connections[$CMId] = @{
                    Name     = $CMName
                    Server   = $Server
                    Database = $Database
                }
            }

            # =================================================
            # CARI COMPONENT
            # =================================================

            $Components = $Xml.SelectNodes(
                "//*[local-name()='component']"
            )

            foreach ($Component in $Components) {

                $ComponentName = ""

                if ($Component.Attributes["name"]) {
                    $ComponentName =
                        $Component.Attributes["name"].Value
                }

                $ComponentClass = ""

                if ($Component.Attributes["componentClassID"]) {
                    $ComponentClass =
                        $Component.Attributes["componentClassID"].Value
                }

                $ComponentXML = $Component.OuterXml

                # ------------------------------------------------
                # OBJECT HARUS ADA DI COMPONENT
                # ------------------------------------------------

                if (
                    $ComponentXML -notmatch
                    "(?i)(?<![A-Za-z0-9_])$([regex]::Escape($ObjectName))(?![A-Za-z0-9_])"
                ) {
                    continue
                }

                # =================================================
                # CARI CONNECTION MANAGER
                # =================================================

                $CMRef = ""

                $CMNode = $Component.SelectSingleNode(
                    ".//*[local-name()='connection']"
                )

                if ($CMNode) {

                    if ($CMNode.Attributes["connectionManagerID"]) {
                        $CMRef =
                            $CMNode.Attributes["connectionManagerID"].Value
                    }

                    if (
                        $CMRef -eq "" -and
                        $CMNode.Attributes["connectionManagerId"]
                    ) {
                        $CMRef =
                            $CMNode.Attributes["connectionManagerId"].Value
                    }
                }

                $Server = ""
                $Database = ""
                $ConnectionName = ""

                if (
                    $CMRef -ne "" -and
                    $Connections.ContainsKey($CMRef)
                ) {

                    $Server =
                        $Connections[$CMRef].Server

                    $Database =
                        $Connections[$CMRef].Database

                    $ConnectionName =
                        $Connections[$CMRef].Name
                }

                # =================================================
                # DETEKSI SOURCE
                # =================================================

                $IsSource = $false

                if (
                    $ComponentClass -match '(?i)OLEDBSource' -or
                    $ComponentName -match '(?i)source'
                ) {
                    $IsSource = $true
                }

                # =================================================
                # DETEKSI DESTINATION
                # =================================================

                $IsDestination = $false

                if (
                    $ComponentClass -match '(?i)OLEDBDestination' -or
                    $ComponentName -match '(?i)destination'
                ) {
                    $IsDestination = $true
                }

                # =================================================
                # DEFAULT
                # =================================================

                $SourceServer = ""
                $SourceDatabase = ""

                $DestinationServer = ""
                $DestinationDatabase = ""

                $DestinationTable = ""

                # =================================================
                # SOURCE
                # =================================================

                if ($IsSource) {

                    $SourceServer = $Server
                    $SourceDatabase = $Database

                    Write-Host "    SOURCE" -ForegroundColor Yellow
                    Write-Host "      Server   : $SourceServer"
                    Write-Host "      Database : $SourceDatabase"
                }

                # =================================================
                # DESTINATION
                # =================================================

                if ($IsDestination) {

                    $DestinationServer = $Server
                    $DestinationDatabase = $Database

                    # --------------------------------------------
                    # OpenRowset
                    # --------------------------------------------

                    $TableMatch = [regex]::Match(
                        $ComponentXML,
                        '(?is)<property[^>]*name=["'']OpenRowset["''][^>]*>(.*?)</property>'
                    )

                    if ($TableMatch.Success) {

                        $DestinationTable =
                            $TableMatch.Groups[1].Value.Trim()
                    }

                    # --------------------------------------------
                    # TableName
                    # --------------------------------------------

                    if ($DestinationTable -eq "") {

                        $TableMatch = [regex]::Match(
                            $ComponentXML,
                            '(?is)<property[^>]*name=["'']TableName["''][^>]*>(.*?)</property>'
                        )

                        if ($TableMatch.Success) {

                            $DestinationTable =
                                $TableMatch.Groups[1].Value.Trim()
                        }
                    }

                    Write-Host "    DESTINATION" -ForegroundColor Yellow
                    Write-Host "      Server   : $DestinationServer"
                    Write-Host "      Database : $DestinationDatabase"
                    Write-Host "      Table    : $DestinationTable"
                }

                # =================================================
                # SIMPAN RESULT
                # =================================================

                $ObjectFound = $true

                $Results.Add(
                    [PSCustomObject]@{
                        ObjectName          = $ObjectName
                        DTSXFile            = $File.Name
                        FullPath            = $File.FullName
                        ComponentName       = $ComponentName
                        ComponentClass      = $ComponentClass
                        SourceServer        = $SourceServer
                        SourceDatabase      = $SourceDatabase
                        DestinationServer   = $DestinationServer
                        DestinationDatabase = $DestinationDatabase
                        DestinationTable    = $DestinationTable
                        ConnectionManager   = $ConnectionName
                    }
                )
            }

            # =================================================
            # OBJECT ADA DI DTSX TAPI TIDAK ADA DI COMPONENT
            # =================================================

            if (-not $ObjectFound) {

                Write-Host "    OBJECT ADA DI XML, COMPONENT TIDAK TERIDENTIFIKASI" `
                    -ForegroundColor Yellow

                $Results.Add(
                    [PSCustomObject]@{
                        ObjectName          = $ObjectName
                        DTSXFile            = $File.Name
                        FullPath            = $File.FullName
                        ComponentName       = ""
                        ComponentClass      = ""
                        SourceServer        = ""
                        SourceDatabase      = ""
                        DestinationServer   = ""
                        DestinationDatabase = ""
                        DestinationTable    = ""
                        ConnectionManager   = ""
                    }
                )
            }

        }
        catch {

            Write-Host ""
            Write-Host "    ERROR : $($_.Exception.Message)" `
                -ForegroundColor Red
        }
    }

    Write-Progress `
        -Id 1 `
        -Activity "Scanning Object: $ObjectName" `
        -Completed

    if (-not $ObjectFound) {

        Write-Host "  -> Object tidak ditemukan pada component DTSX" `
            -ForegroundColor DarkGray
    }
}

# ============================================================
# EXPORT CSV
# ============================================================

$Results |
    Export-Csv `
        -LiteralPath $OutputFile `
        -NoTypeInformation `
        -Encoding UTF8

Write-Host ""
Write-Host "============================================================" -ForegroundColor Green
Write-Host "                 SCREENING SELESAI" -ForegroundColor Green
Write-Host "============================================================" -ForegroundColor Green
Write-Host "Total Object       : $TotalObjects"
Write-Host "Total DTSX         : $TotalFiles"
Write-Host "Total Match        : $($Results.Count)"
Write-Host "Output             : $OutputFile"
Write-Host "============================================================" -ForegroundColor Green
Write-Host ""