CREATE FUNCTION dbo.fn_ProperCase (@Text VARCHAR(MAX))
RETURNS VARCHAR(MAX)
AS
BEGIN
    DECLARE @Result VARCHAR(MAX) = LOWER(@Text);
    DECLARE @i INT = 1;

    SET @Result = STUFF(@Result, 1, 1, UPPER(LEFT(@Result,1)));

    WHILE @i <= LEN(@Result)
    BEGIN
        IF SUBSTRING(@Result,@i,1) = ' '
            SET @Result = STUFF(@Result,@i+1,1,
                                UPPER(SUBSTRING(@Result,@i+1,1)));
        SET @i = @i + 1;
    END

    RETURN @Result;
END
